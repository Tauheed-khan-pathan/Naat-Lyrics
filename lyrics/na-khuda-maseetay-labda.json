  "urdu": [
    "نہ خدا مسیتے لبھدا",
    "نہ خدا وچ کعبے",
    "نہ خدا قرآن کتاباں",
    "نہ خدا نمازے",
    "نہ رب عرش معلیٰ اتے",
    "نہ رب خانے کعبے ہو",
    "نہ رب علم کتابی لبھا",
    "نہ رب وچ محرابے ہو",
    "گنگا تیرتھ مول نہ ملیا",
    "پیندے بے حسابے ہو",
